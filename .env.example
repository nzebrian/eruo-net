# EruoNet local development environment example.
# Copy to .env for local use. Never commit .env files or real secrets.

ERUONET_ENV=development
ERUONET_LOG_LEVEL=info
ERUONET_API_PORT=8080
ERUONET_WEB_PORT=3000
ERUONET_CONTROL_CENTER_PORT=3001

# Use non-secret placeholders only.
ERUONET_DATABASE_URL=postgresql://eruo_dev:change-me@localhost:5432/eruo_dev
ERUONET_REDIS_URL=redis://localhost:6379/0
